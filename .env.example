# Copy this file to .env and fill in ONE of the following (not all three).
# None are required -- with no key set, the memory system uses an extractive
# fallback answerer and the action parser uses its rule-based path. A key
# only improves answer quality and action-parsing robustness.

# --- Option 1: Google Gemini (recommended -- has a free tier) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Option 2: Anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Option 3: OpenAI (or any OpenAI-compatible endpoint) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: skip the extra LLM query-expansion call in retrieval (saves ~1
# call per question -- useful on a tight free-tier rate limit).
# DISABLE_LLM_QUERY_EXPANSION=1
