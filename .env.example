# Copy to .env and fill in ONE provider. None are required: with no key the memory
# system uses an extractive fallback and actions use the rules path (88% retrieval,
# 12/12 actions on train). A model adds the reranker, better answers, memory-backed actions.
# The first line of every run prints which provider/model is active. If more than one key
# is present, force one with LLM_PROVIDER=anthropic|gemini|openai.

# --- Option 1: Google Gemini (free tier; daily quota is small -- a full run can exhaust it) ---
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=            # leave unset: a retired/unknown model is auto-resolved via ListModels

# --- Option 2: Anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Option 3: OpenAI-compatible (settings used for the reported live numbers: Groq free tier) ---
# Key at https://console.groq.com/keys (no card)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_REASONING_EFFORT=low       # reasoning models only
# LLM_MAX_TOKENS_FLOOR=2048         # headroom so a reasoning model's answer isn't cut off

# --- Tuning for tight free-tier token limits (what the reported numbers used) ---
# LLM_MIN_INTERVAL=2.5              # seconds between calls (Gemini default 4.2, others 0)
# RERANK_POOL=30                    # candidates the model reranks (default 45)
# RERANK_SNIPPET_CHARS=400          # chars shown per candidate (default 700)
# ANSWER_CONTEXT_K=10               # records handed to the answer writer (default 12)

# Optional extra: LLM query expansion (off by default; the reranker sees the records itself)
# ENABLE_LLM_QUERY_EXPANSION=1
